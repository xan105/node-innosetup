{
  "name": "@xan105/innosetup",
  "version": "0.1.1",
  "description": "Compile innosetup script (.iss) to create Windows installer/setup.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./lib/index.js"
    }
  },
  "types": "./types/index.d.ts",
  "files": [
    "/lib",
    "/vendor",
    "/types",
    "/default.iss"
  ],
  "engines": {
    "node": ">=24.13.0",
    "npm": "^11.6.2"
  },
  "bin": {
    "innosetup": "lib/cli.js"
  },
  "scripts": {
    "lint": "biome lint",
    "test": "node --test"
  },
  "keywords": [
    "innosetup",
    "setup",
    "installer",
    "windows"
  ],
  "author": {
    "name": "Anthony Beaumont",
    "email": "dev.xan105@outlook.be",
    "url": "https://xan105.com/"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xan105/node-innosetup.git"
  },
  "bugs": {
    "url": "https://github.com/xan105/node-innosetup/issues"
  },
  "homepage": "https://github.com/xan105/node-innosetup",
  "funding": [
    {
      "type": "github",
      "url": "https://github.com/sponsors/xan105"
    },
    {
      "type": "paypal",
      "url": "https://www.paypal.me/xan105"
    }
  ],
  "devDependencies": {
    "@biomejs/biome": "^2.3.12"
  },
  "dependencies": {
    "@xan105/types": "^0.3.0"
  }
}
